{
  "autosave": false,
  "background": false,
  "colors": false,
  "title": false,
  "randomx": {
    "init": -1,
    "init-avx2": -1,
    "mode": "auto",
    "1gb-pages": false,
    "rdmsr": false,
    "wrmsr": false,
    "cache_qos": false,
    "numa": true,
    "scratchpad_prefetch_mode": 1
  },
  "cpu": {
    "enabled": true,
    "huge-pages": true,
    "yield": true
  },
  "http": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 8080,
    "access-token": null,
    "restricted": true
  },
  "donate-level": 0,
  "donate-over-proxy": 0,
  "pools": [
    {
      "url": "CHANGE-ME.example:3333",
      "user": "${HOSTNAME}",
      "pass": "",
      "keepalive": true
    }
  ],
  "print-time": 60,
  "health-print-time": 60,
  "retries": 5,
  "retry-pause": 5,
  "syslog": false,
  "tls": {
    "enabled": false
  },
  "user-agent": null,
  "verbose": 0,
  "watch": true
}
